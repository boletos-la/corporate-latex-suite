  \begin{corpcrypto}
    \noindent\textbf{SELLO DIGITAL CRIPTOGRAFICO BNW TRUST NETWORK (2PC-VERIFIED)}\\[2pt]
    SHA-256: \texttt{#1}\\[1pt]
    TIMESTAMP: \texttt{#2} -- EMISOR: \texttt{#3} -- ESTADO: CONCILIADO
  \end{corpcrypto}
}

