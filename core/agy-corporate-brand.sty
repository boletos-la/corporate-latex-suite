% Common Headers & Footers
\newcommand{\setupcorporateheader}[2]{%
  \pagestyle{fancy}
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \setlength{\headheight}{38pt}
  \setlength{\headsep}{16pt}
  
  \fancyhead[L]{%
    \noindent\parbox[c]{0.5\textwidth}{%
      \IfFileExists{\corporatebrandlogolight}{%
        \includegraphics[height=18pt,keepaspectratio]{\corporatebrandlogolight}\\[2pt]%
      }{%
        \IfFileExists{\corporatebrandlogo}{%
          \includegraphics[height=18pt,keepaspectratio]{\corporatebrandlogo}\\[2pt]%
        }{%
          {\bfseries\color{corpDarkHeader}\corporatebrandname}\\[2pt]%
        }%
      }%
      {\fontsize{7}{8}\selectfont\color{corpTextMuted}\corporatebrandtagline}
    }%
  }
  \fancyhead[R]{%
    \noindent\parbox[c]{0.48\textwidth}{\raggedleft%
      {\fontsize{9}{11}\selectfont\bfseries\color{corpDarkHeader}#1}\\[1pt]
      {\fontsize{7}{8}\selectfont\color{corpTextAccent}#2}
    }%
  }
  \fancyfoot[L]{%
    {\fontsize{7}{8}\selectfont\color{corpTextMuted}\corporatebrandlegal\ -- \corporatebrandrut\ -- \corporatebrandweb}%
  }
  \fancyfoot[R]{%
    {\fontsize{7}{8}\selectfont\color{corpTextMuted}Pagina \thepage\ de \pageref{LastPage}}%
  }
}

% Plain page style for first page / covers
\fancypagestyle{corporateplain}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyfoot[L]{{\fontsize{7}{8}\selectfont\color{corpTextMuted}\corporatebrandlegal\ -- \corporatebrandweb}}
  \fancyfoot[R]{{\fontsize{7}{8}\selectfont\color{corpTextMuted}Pagina \thepage\ de \pageref{LastPage}}}
}

% =============================================================================
% PORTADA EJECUTIVA FULL-BLEED 360° (PRIMERA PÁGINA OSCURA OFICIAL)
% =============================================================================
\newcommand{\makecorporatedarkcover}[8]{%
  \begin{titlepage}
  \hypersetup{pageanchor=false}
  \pagecolor{corpSurface}
  \color{white}
  \vspace*{0.8cm}
  
  \begin{center}
    % Logotipo Institucional Blanco para fondo oscuro
    \IfFileExists{\corporatebrandlogodark}{%
      \includegraphics[height=1.6cm,keepaspectratio]{\corporatebrandlogodark}\\[0.4cm]
    }{%
      \IfFileExists{\corporatebrandlogo}{%
        \includegraphics[height=1.6cm,keepaspectratio]{\corporatebrandlogo}\\[0.4cm]
      }{%
        {\Huge\bfseries\color{white}\corporatebrandname}\\[0.4cm]
      }%
    }%
    {\large\textsc{\color{corpDarkCoverAccent}\corporatebrandtagline}}\\[0.6cm]
    
    % Barra Cromática Institucional de Acento
    \drawchromaticbar[3.5pt]
    \vspace{0.6cm}
    
    % Títulos y Subtítulos Paramétricos
    {\fontsize{22}{28}\selectfont\bfseries #1\par}
    \vspace{0.4cm}
    {\large\bfseries\color{corpDarkCoverAccent}#2\par}
    \vspace{0.3cm}
    {\small\color{white!85}#3\par}
    \vspace{0.6cm}
    
    % Barra de Acento Inferior
    \drawchromaticbar[2pt]
    \vspace{0.6cm}
    
    % Tarjeta de Metadatos de la Portada
    \begin{tcolorbox}[
      enhanced,
      colback=corpSurface!85!black,
      colframe=corpDarkCoverAccent,
      arc=3mm,
      boxrule=1.1pt,
      width=0.96\textwidth,
      drop shadow={opacity=0.3, shadow xshift=2pt, shadow yshift=-2pt}
    ]
      \color{white}
      \renewcommand{\arraystretch}{1.35}
      \begin{tabularx}{\linewidth}{@{}l X@{}}
        \textbf{\textcolor{corpDarkCoverAccent}{Entidad Emisora:}} & \corporatebrandlegal \\
        \textbf{\textcolor{corpDarkCoverAccent}{Destinatario / Alcance:}} & #4 \\
        \textbf{\textcolor{corpDarkCoverAccent}{Dirección y Liderazgo Técnico:}} & \textbf{#5} \\
        \textbf{\textcolor{corpDarkCoverAccent}{Fecha de Emisión:}} & #6 \\
        \textbf{\textcolor{corpDarkCoverAccent}{Código de Referencia:}} & \texttt{#7} \\
        \textbf{\textcolor{corpDarkCoverAccent}{Veredicto de Auditoría / Estado:}} & \textbf{\color{corpSuccess}#8} \\
      \end{tabularx}
    \end{tcolorbox}
    
    \vfill
    {\footnotesize\color{gray!40}\corporatebrandlegal\ $\bullet$\ \corporatebrandrut\ $\bullet$\ \corporatebrandweb}
  \end{center}
  \end{titlepage}
  \pagecolor{white}
  \color{corpTextDark}
  \clearpage
}

% TColorBox Corporate Environments
\newtcolorbox{corpcard}[2][]{%
  enhanced,
  colback=white,
  colframe=corpBorder,
  coltitle=corpPrimary,
  fonttitle=\bfseries\sffamily,
  arc=3mm,
  boxrule=0.8pt,
  leftrule=4pt,
  titlerule=0pt,
  title={#2},
  colbacktitle=white,
  attach boxed title to top left={yshift=-2mm, xshift=3mm},
  boxed title style={boxrule=0pt, colframe=white, colback=white},
  drop shadow={opacity=0.04, shadow xshift=1mm, shadow yshift=-1mm},
  #1
}

