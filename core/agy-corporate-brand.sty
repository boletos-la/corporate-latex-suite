% Dual Control Signatures Macro
\newcommand{\dualcontrolsignature}[6]{%
  \vspace{1.5em}
  \noindent\begin{minipage}[t]{0.47\textwidth}
    \begin{center}
      \rule{0.8\textwidth}{0.6pt}\\[4pt]
      {\small\bfseries\color{corpPrimary}#1}\\[1pt]
      {\footnotesize\color{corpTextMuted}#2}\\[1pt]
      {\scriptsize\color{corpTextMuted}#3}
    \end{center}
  \end{minipage}\hfill
  \begin{minipage}[t]{0.47\textwidth}
    \begin{center}
      \rule{0.8\textwidth}{0.6pt}\\[4pt]
      {\small\bfseries\color{corpPrimary}#4}\\[1pt]
      {\footnotesize\color{corpTextMuted}#5}\\[1pt]
      {\scriptsize\color{corpTextMuted}#6}
    \end{center}
  \end{minipage}
}

% Cryptographic Seal Macro
